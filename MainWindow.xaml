<Window x:Class="WidgetHorario.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Horario"
        Width="1100"
        Height="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border
        Background="#18181B"
        CornerRadius="20"
        BorderBrush="#333338"
        BorderThickness="1"
        Padding="20">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CABECERA -->

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock
                        Text="HORARIO"
                        Foreground="White"
                        FontSize="24"
                        FontWeight="Bold"/>

                    <TextBlock
                        x:Name="FechaText"
                        Foreground="#888890"
                        FontSize="14"
                        Margin="0,4,0,0"/>

                </StackPanel>

                <TextBlock
                    x:Name="HoraText"
                    Grid.Column="1"
                    Foreground="White"
                    FontSize="24"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

            </Grid>

            <!-- TABLA -->

            <Grid
                x:Name="HorarioGrid"
                Grid.Row="1"
                Margin="0,25,0,0"/>

        </Grid>

    </Border>

</Window>