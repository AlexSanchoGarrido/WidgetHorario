<Window x:Class="WidgetHorario.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Horario"
        Width="1100"
        Height="700"
        MinWidth="500"
        MinHeight="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Opacity="0.90"
        Background="Transparent"
        ResizeMode="CanResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove">

    <Border
        Background="#18181B"
        CornerRadius="20"
        BorderBrush="#333338"
        BorderThickness="1"
        Padding="20">

        <!-- ÚNICO HIJO DEL BORDER -->
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CABECERA -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- TÍTULO Y FECHA -->
                <StackPanel Grid.Column="0">

                    <TextBlock
                        Text="HORARIO"
                        Foreground="White"
                        FontSize="24"
                        FontWeight="Bold"/>

                    <TextBlock
                        x:Name="FechaText"
                        Foreground="#888890"
                        FontSize="14"
                        Margin="0,4,0,0"/>

                </StackPanel>

                <!-- BOTÓN TOPMOST + HORA -->
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <Button
                        x:Name="TopmostButton"
                        Content="📌"
                        Width="40"
                        Height="40"
                        Margin="0,0,12,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#888890"
                        FontSize="18"
                        ToolTip="Fijar encima"
                        Click="TopmostButton_Click"/>

                    <TextBlock
                        x:Name="HoraText"
                        Foreground="White"
                        FontSize="24"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"/>

                </StackPanel>

            </Grid>

            <!-- TABLA -->
            <Grid
                x:Name="HorarioGrid"
                Grid.Row="1"
                Margin="0,25,0,0"/>

        </Grid>

    </Border>

</Window>